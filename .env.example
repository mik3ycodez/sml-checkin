# Copy to .env.local and fill in real values. Never commit .env.local.
#
# Every value below is a placeholder. In live mode the server refuses to start
# if a required setting is missing, blank, or still one of these placeholders,
# and says which setting (never its value). Settings marked SECRET must never
# be committed, logged or shared.

# TidyHQ client: "mock" (in-memory seed data) or "live" (the real TidyHQ).
# Defaults to mock in development. Required in production: the server refuses
# to start without it, so a deploy never falls back to mock by accident. Mock
# mode in production is refused too, unless DEMO_MODE=on (below).
TIDYHQ_MODE=mock

# Set to "on" to run a public demo site on mock data. Every page then shows a
# "Demo data" banner. Needed to run mock mode in production (anyone can sign in
# as any seed member there, so it must be on purpose); refused with
# TIDYHQ_MODE=live. Leave blank (or "off") otherwise; anything but "on", "off"
# or blank stops the server from starting.
DEMO_MODE=

# This site's public address: scheme and host only, no path or trailing slash.
# Required in production (the server refuses to start without it); in
# development it's worked out from each request, so it can stay unset.
# It is also:
#   - the address to register with TidyHQ: the OAuth redirect URI is
#     APP_ORIGIN + /auth/callback, and must match exactly;
#   - the base for event QR codes, which link to APP_ORIGIN + /checkin/<eventId>.
# In production and in live mode it must be https (http is only allowed for
# localhost and 127.0.0.1); cookies are marked Secure when it is https.
# Live mode rejects this placeholder: set your own address.
# Changing it means re-registering with TidyHQ and reprinting QR codes.
APP_ORIGIN=https://checkin.example.org

# TidyHQ OAuth app credentials (live mode only; required there).
# TIDYHQ_CLIENT_SECRET is a SECRET: it is only ever sent server-side, to
# TidyHQ's token endpoint, and is never logged or put in an error.
TIDYHQ_CLIENT_ID=your-client-id
TIDYHQ_CLIENT_SECRET=your-client-secret
# The TidyHQ organisation to sign members in to: a plain subdomain (SML's is
# "sml", which is also the default if you leave this out).
TIDYHQ_DOMAIN_PREFIX=sml

# Admin-level token for server-side TidyHQ calls (live mode only; required
# there). SECRET: it can read and edit member data.
TIDYHQ_ADMIN_TOKEN=your-admin-token

# SECRET. Signs member session cookies. Required in every mode. At least 32
# random characters; live mode rejects this placeholder.
# Generate one with: openssl rand -base64 32
# Changing it signs everyone out, since existing cookies no longer verify.
# Rotate it when switching TIDYHQ_MODE from mock to live (mock sessions hold
# mock contact ids), and as an emergency sign-out for all members.
SESSION_SECRET=replace-with-output-of-openssl-rand-base64-32

# Optional (the three group ids below never stop the server starting).
#
# The TidyHQ contact group whose members may use the admin pages ("App Admin").
# The Board adds and removes admins in TidyHQ; it's checked on every admin
# request, so a removal takes effect on the person's next page load.
# Live mode: set this to the group's id (SML's is in docs/plans/milestone-4.md).
# If it's unset, blank, or unreadable, nobody gets into the admin pages (member
# check-in is unaffected). Mock mode falls back to the seed's App Admin group,
# so leave this blank for development: a placeholder value would count as set.
ADMIN_GROUP_ID=

# The TidyHQ contact group whose members may check members in at the door
# without being admins. Set it to the "App Check-In Volunteers" group, NOT
# SML's general "Volunteers" group: everyone in this group can check anyone in. Members of App Admin
# qualify too. Same rules as ADMIN_GROUP_ID: checked on every request, fails
# closed if unset, blank, or unreadable (member check-in is unaffected), and
# mock mode falls back to the seed's volunteers group, so leave this blank for
# development. Live mode: set this to the group's id (SML's is in
# docs/plans/milestone-5.md, Go-live checklist).
HELPER_GROUP_ID=
