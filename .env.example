# Copy to .env.local and fill in real values. Never commit .env.local.

# TidyHQ client: "mock" (in-memory seed data) or "live" (real API, not implemented yet).
# Defaults to mock in development. Required in production: the server refuses
# to start without it, so a deploy never falls back to mock by accident.
TIDYHQ_MODE=mock

# TidyHQ OAuth app credentials (live mode only)
TIDYHQ_CLIENT_ID=your-client-id
TIDYHQ_CLIENT_SECRET=your-client-secret
TIDYHQ_DOMAIN_PREFIX=sml

# Admin-level token for server-side TidyHQ calls (live mode only)
TIDYHQ_ADMIN_TOKEN=your-admin-token

# Signs member session cookies. Required. At least 32 random characters.
# Generate one with: openssl rand -base64 32
# Changing it signs everyone out, since existing cookies no longer verify.
# Rotate it when switching TIDYHQ_MODE from mock to live (mock sessions hold
# mock contact ids), and as an emergency sign-out for all members.
SESSION_SECRET=replace-with-output-of-openssl-rand-base64-32
